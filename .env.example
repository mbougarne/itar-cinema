# SERVER / LOCAL PROXY ONLY. React Native must never load this file or a real key.
# TMDB (The Movie Database), confirmed provider. Values below contain no credentials.
MOVIE_DATABASE_PROVIDER=TMDB
MOVIE_DATABASE_API_KEY=YOUR_SERVER_SIDE_TMDB_V3_API_KEY
MOVIE_DATABASE_BASE_URL=https://api.themoviedb.org/3
# Server-only reference values. The included local proxy binds port 8789.
# See docs/tmdb-proxy.md; React Native never reads these values.
MOVIE_DATABASE_PROXY_PORT=8789
